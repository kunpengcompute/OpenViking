# Chat defaults. Exported process variables override this file.
# Session creation resolves overrides once; subsequent Agent rebuilds reuse its snapshot.
# All four commit fields are required; the current profile enables this policy.
OV_COMMIT__TOKEN_BUDGET=256000
OV_COMMIT__COMMIT_TOKEN_THRESHOLD_RATIO=0.7
OV_COMMIT__COMPLETED_RUN_THRESHOLD=5
OV_COMMIT__KEEP_RECENT_COUNT=8

# Model context budgets; resolved values are frozen when creating a Session.
OV_CONTEXT__CONTEXT_WINDOW=256000
OV_CONTEXT__BASE_CONTEXT_RATIO=0.3
OV_CONTEXT__CAPACITY_RATIO=0.7
OV_CONTEXT__SAFETY_MARGIN=512
# Archive generation is awaited separately from each short OV HTTP request.
OV_CONTEXT__COMMIT_WAIT_TIMEOUT=300
OV_CONTEXT__POLL_INTERVAL=0.5
OV_CONTEXT__POLL_MAX_INTERVAL=2
OV_CONTEXT__RETRY_ATTEMPTS=2
OV_CONTEXT__TOOL_RESULTS=true
# A separately deployed trusted OV can use the matching server.root_api_key here.
# OV_SERVICE_API_KEY=

# Reader settings.
OV_READER__SEARCH_MODE=context
OV_READER__ENABLED=true
# null uses category roots with quotas; without quotas it uses user/Agent memories.
# An explicit memory URI restricts resource and skill quotas to that scope too.
OV_READER__TARGET_URIS=null
OV_READER__CANDIDATE_LIMIT=25
OV_READER__RECALL_LIMIT=5
OV_READER__SCORE_THRESHOLD=0.1
OV_READER__PREFER_ABSTRACT=true
OV_READER__RANKING=openclaw
OV_READER__PREFER_LEAF=true
OV_READER__MAX_INJECTED_CHARS=4000
OV_READER__RECALL_TIMEOUT=30
OV_READER__EXPERIENCE_ENABLED=false
OV_READER__EXPERIENCE_TARGET_URIS='["viking://user/memories/experiences"]'
OV_READER__EXPERIENCE_CANDIDATE_LIMIT=12
OV_READER__EXPERIENCE_LIMIT=3
OV_READER__EXPERIENCE_SCORE_THRESHOLD=0.35
OV_READER__EXPERIENCE_MAX_CHARS=2000
OV_READER__EXPERIENCE_MIN_QUERY_CHARS=12
OV_READER__CONTEXT_TIMEOUT=10
OV_READER__CONTEXT_TOKEN_BUDGET=256000

# Chat-only protection: bounds each awaited OV stage, not the model/browser.
OV_CHAT__IO_TIMEOUT=5
OV_CHAT__FAIL_OPEN=true
# Expand the default user memory root with the invoking Agent's peer memories.
OV_CHAT__RECALL_AGENT_MEMORIES=true

# Chat planning tool default; new sessions can override it.
CHAT_AGENT__ENABLE_TODOS=true

# Streaming: max wait for the first/next packet; each packet resets the timer.
# Nonstreaming: max wait for the complete response. The Run timeout is separate.
CHAT_MODEL__CALL_TIMEOUT_SECONDS=180
