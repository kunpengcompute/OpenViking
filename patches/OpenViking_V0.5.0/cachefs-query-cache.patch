+use super::*;
+
+fn generations() -> Vec<GenerationSnapshot> {
+    vec![GenerationSnapshot {
+        key: "ragfs:v2:test:subtree:0123456789abcdef".to_string(),
+        value: u64::MAX,
+    }]
+}
