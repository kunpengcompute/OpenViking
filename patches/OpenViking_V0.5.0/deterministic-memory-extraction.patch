+    max_supplementary_queries: int = Field(default=2, ge=0, le=3)
+    use_memories: bool = False
+    use_events: bool = False
+    use_graph: bool = False
+    use_time: bool = False
+    event_top_k: int = Field(default=2, ge=1, le=20)
+    telemetry: TelemetryRequest = False
+
