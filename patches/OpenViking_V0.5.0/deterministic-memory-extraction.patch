+async def cleanup_source_memories(
+    fs, index, index_uri, index_lease, source_ids, ctx, *, vikingdb=None
+):
+    """Prune self and peer cards that reference the same user-owned sources."""
+    user_root = index_uri.rsplit("/.index/", 1)[0]
+    roots = {user_root + "/memories"}
+    peers = user_root + "/peers"
+    if await fs.exists(peers, ctx=ctx):
+        for item in await fs.ls(peers, ctx=ctx):
+            name = item.get("name") if isinstance(item, dict) else item
+            if isinstance(name, str) and name not in ("", ".", "..") and "/" not in name:
+                roots.add(peers + "/" + name + "/memories")
+    for uri in index.pending_memory_cleanup:
+        root = uri.split("/memories/", 1)[0] + "/memories"
+        peer_parts = root.removeprefix(peers + "/").split("/")
+        is_peer_root = (
+            root.startswith(peers + "/")
+            and len(peer_parts) == 2
+            and peer_parts[0] not in ("", ".", "..")
+            and peer_parts[1] == "memories"
+        )
+        if root != user_root + "/memories" and not is_peer_root:
+            raise ValueError("Cleanup journal contains an out-of-scope memory URI")
+        roots.add(root)
+    result = {"updated": 0, "deleted": 0}
+    for root in sorted(roots):
+        counts = await _cleanup_memory_root(
+            fs, index, index_uri, index_lease, source_ids, ctx, root=root, vikingdb=vikingdb
+        )
+        for key in result:
+            result[key] += counts[key]
+    return result
