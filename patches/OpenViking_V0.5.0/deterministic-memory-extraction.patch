+
+    for module in ("evidence_retriever", "evidence_ranking"):
+        monkeypatch.setattr(f"openviking.retrieve.{module}.extract_keys", features)
+
+
+def append(index, session="ordinary", ids=("m1", "m2")):
+    index.append_chunk(
+        session,
+        [
+            {
+                "id": sid,
+                "speaker": "user",
