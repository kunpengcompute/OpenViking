+                    continue
+                personal_subject = any(
+                    token.dep_ in {"nsubj", "nsubjpass"} and token.lower_ in {"i", "we"}
+                    for token in doc
+                )
+                owned_subject = any(
+                    token.dep_ in {"nsubj", "nsubjpass"}
+                    and any(child.lower_ in {"my", "our"} for child in token.children)
+                    for token in doc
+                )
+                if not (personal_subject or owned_subject):
+                    continue
+        start = text.find(quote)
+        context = ""
+        if start > 0 and (
+            re.search(r"\b(?:it|its|their|this|that|those|these)\b", quote, re.I) or quantity
+        ):
+            prefix = text[:start].strip()
+            context = prefix[-200:] if prefix else ""
+        selected.append(
+            {
+                "fact": fact,
+                "quantity": quantity,
+                "scope": _scope(quote),
+                "time_expression": time.group(0) if time else None,
+                "speaker": "user",
+                "content": quote,
+                "context": context,
+            }
+        )
+    return selected
+
+
+def select_assistant_facts(
+    text: str,
+    previous_user_text: str,
+    source_id: str,
+    recorded_at: datetime | None,
+    speaker: str = "assistant",
+) -> list[dict]:
+    """Keep compact, source-backed suggestions and named examples from replies."""
+    if not (
+        _SUGGESTION.search(previous_user_text)
+        or re.search(r"\b(?:other alternatives|other options|some suggestions)\b", text[:180], re.I)
+    ):
+        return []
+    from openviking.session.memory.deterministic_rules import _resolve_dates_in_text
+
+    facts = make_fact_records(
+        text, speaker, source_id, recorded_at, _resolve_dates_in_text, role="assistant"
+    )
+    rows = []
+    for line in text.splitlines():
+        match = _LIST_ITEM.match(line)
+        if not match:
+            continue
+        label = match.group(1).strip(" *\t.!")
+        if not 2 <= len(label) <= 75 or len(label.split()) > 8:
+            continue
+        fact = next(
+            (f for f in facts if label.casefold() in f["source_quotes"][source_id].casefold()), None
+        )
+        if fact:
+            rows.append(
+                {
+                    "fact": fact,
+                    "speaker": "assistant",
+                    "label": label,
+                    "content": f"Assistant suggested: {label}. User asked: {previous_user_text[:160]}",
+                }
+            )
+    if 2 <= len(rows) <= 12:
+        return rows
+    rows = []
+    for fact in facts:
+        quote = fact["source_quotes"][source_id]
+        if _QUOTED_TITLE.search(quote) and re.search(
+            r"\b(?:example|cartoon|film|book|title|called|such as)\b", quote, re.I
+        ):
+            rows.append(
+                {
+                    "fact": fact,
+                    "speaker": "assistant",
+                    "label": None,
+                    "content": f"Assistant mentioned: {quote[:300]}. User asked: {previous_user_text[:160]}",
+                }
+            )
+    return rows[:4]
