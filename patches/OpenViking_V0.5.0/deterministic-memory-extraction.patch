index 0000000000000000000000000000000000000000..66f47e2b41780e499591bab7c77681e84cbd21f9
--- /dev/null
+++ b/openviking/retrieve/evidence_fusion.py
@@ -0,0 +1,242 @@
+# Copyright (c) 2026 Beijing Volcano Engine Technology Co., Ltd.
+# SPDX-License-Identifier: AGPL-3.0
+"""Opt-in graph and temporal candidates over one authorized evidence snapshot."""
+
+from __future__ import annotations
+
+import math
+import re
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+from openviking.retrieve.evidence_graph import extract_graph_entity_signals, parse_recorded_time
+
+
+@dataclass(frozen=True)
+class AuxHit:
+    turn_id: str
+    channel: str
+    raw_score: float
+    source_window_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class EvidenceIntent:
+    name: str
+    rho: float
+    channel: str | None
+
+
+_RELATION = re.compile(
+    r"\b(relationship|related|relation|connect|between|affect|involve|belong|associated|whose|who is)\b|关系|关联|属于|涉及",
+    re.I,
+)
+_OPEN = re.compile(
+    r"\b(?:open\s+(?:items|tasks|issues|tickets)|pending|unfinished|outstanding|still need|todo|remaining|remains)\b|待办|未完成|还需|尚未",
+    re.I,
+)
+_MONTHS = {
+    name: i
+    for i, name in enumerate(
+        (
+            "january",
+            "february",
+            "march",
+            "april",
+            "may",
+            "june",
+            "july",
+            "august",
+            "september",
+            "october",
+            "november",
+            "december",
+        ),
+        1,
+    )
+}
+_MONTH_PATTERN = "|".join(_MONTHS)
+
+
+def _date_span(question: str) -> tuple[datetime, datetime] | None:
+    m = re.search(r"(?<!\d)(\d{4})-(\d{2})-(\d{2})(?!\d)", question)
+    if m:
+        try:
+            day = datetime(int(m[1]), int(m[2]), int(m[3]), tzinfo=timezone.utc)
+            return day, day.replace(hour=23, minute=59, second=59)
+        except ValueError:
+            return None
+    m = re.search(rf"\b({_MONTH_PATTERN})\s+(\d{{4}})\b", question, re.I)
+    if m:
+        month, year = _MONTHS[m[1].lower()], int(m[2])
+    else:
+        m = re.search(r"(?<!\d)(\d{4})年\s*(\d{1,2})月", question)
+        if not m:
+            return None
+        year, month = int(m[1]), int(m[2])
+    try:
+        start = datetime(year, month, 1, tzinfo=timezone.utc)
+        next_month = datetime(year + (month == 12), month % 12 + 1, 1, tzinfo=timezone.utc)
+        from datetime import timedelta
+
+        return start, next_month - timedelta(seconds=1)
+    except ValueError:
+        return None
+
+
+def classify_evidence_intent(question: str) -> EvidenceIntent:
+    if _date_span(question):
+        return EvidenceIntent("HISTORICAL_DECISIONS", 0.7, "time")
+    if _OPEN.search(question):
+        return EvidenceIntent("OPEN_ITEMS", 0.7, "time")
+    if _RELATION.search(question):
+        return EvidenceIntent("ENTITY_RELATIONS", 0.3, "graph")
+    return EvidenceIntent("OTHER", 1.0, None)
+
+
+def graph_candidates(
+    index, question: str, *, max_seeds: int = 5, per_seed: int = 5
+) -> list[AuxHit]:
+    if index.graph_unavailable or not index.graph["windows"]:
+        return []
+    seeds = sorted(
+        {s.key for s in extract_graph_entity_signals(question)},
+        key=lambda key: (-len(key.split(":", 1)[1]), key),
+    )[:max_seeds]
+    if not seeds:
+        return []
+    matches: dict[str, AuxHit] = {}
+    from openviking.retrieve.evidence_features import _STOP, extract_keys
+
+    query_keys = extract_keys(question)[1]
+    query_terms = {w for w in re.findall(r"[A-Za-z]{4,}", question.lower()) if w not in _STOP}
+    for seed in seeds:
+        edges = [
+            index.graph["appears_in"][key]
+            for key in index._graph_inv.get(seed, ())
+            if index.graph["appears_in"][key]["weight"] >= 0.7
+        ]
+        # Very common names are poor graph seeds; keep exact rare names.
+        if index._n_turns >= 10 and sum(len(e["turn_ids"]) for e in edges) > index._n_turns * 0.4:
+            continue
+        edges.sort(key=lambda e: (-e["weight"], e["window_id"]))
+        count = 0
+        for edge in edges:
+            for tid in edge["turn_ids"]:
+                if tid not in index._turn_by_id:
+                    continue
+                hit = AuxHit(tid, "graph", edge["weight"], (edge["window_id"],))
+                if tid not in matches or hit.raw_score > matches[tid].raw_score:
+                    matches[tid] = hit
+                count += 1
+                if count >= per_seed:
+                    break
+            if count >= per_seed:
+                break
+            for adjacent in index._graph_adj_inv.get(edge["window_id"], ()):
+                if adjacent.get("scope") != "same_session":
+                    continue
+                neighbor = (
+                    adjacent["to_window_id"]
+                    if adjacent["from_window_id"] == edge["window_id"]
+                    else adjacent["from_window_id"]
+                    if adjacent["to_window_id"] == edge["window_id"]
+                    else None
+                )
+                if neighbor is None:
+                    continue
+                window = index.graph["windows"].get(neighbor)
+                if not window:
+                    continue
+                for tid in window["turn_ids"]:
+                    turn = index._turn_by_id.get(tid)
+                    if turn is None:
+                        continue
+                    terms = set(re.findall(r"[A-Za-z]{4,}", turn["text"].lower()))
+                    if not (query_keys & set(turn.get("keys", [])) or query_terms & terms):
+                        continue
+                    hit = AuxHit(tid, "graph", edge["weight"] * 0.5, (neighbor,))
+                    if tid not in matches:
+                        matches[tid] = hit
+                    count += 1
+                    if count >= per_seed:
+                        break
+                if count >= per_seed:
+                    break
+    return sorted(matches.values(), key=lambda h: (-h.raw_score, h.turn_id))[: max_seeds * per_seed]
+
+
+def time_candidates(
+    index, question: str, *, now: datetime, content_turn_ids: set[str], limit: int = 5
+) -> list[AuxHit]:
+    if index.graph_unavailable:
+        return []
+    span = _date_span(question)
+    open_items = bool(_OPEN.search(question)) and span is None
+    if span is None and not open_items:
+        return []
+    if now.tzinfo is None:
+        now = now.replace(tzinfo=timezone.utc)
+    rows = []
+    for wid, window in index.graph["windows"].items():
+        start = parse_recorded_time(window.get("when_start"))
+        end = parse_recorded_time(window.get("when_end"))
+        if start is None or end is None:
+            continue
+        lo, hi = datetime.fromisoformat(start), datetime.fromisoformat(end)
+        if span:
+            if hi < span[0] or lo > span[1]:
+                continue
+            distance = 0
+        else:
+            distance = max(0, (now - hi).total_seconds() / 86400)
+        score = math.exp(-distance / 30)
+        for tid in window["turn_ids"]:
+            if tid in index._turn_by_id and (not open_items or tid in content_turn_ids):
+                rows.append(AuxHit(tid, "time", score, (wid,)))
+    by_id = {hit.turn_id: hit for hit in sorted(rows, key=lambda h: (-h.raw_score, h.turn_id))}
+    return sorted(by_id.values(), key=lambda h: (-h.raw_score, h.turn_id))[:limit]
+
+
+def fuse_auxiliary(
+    content_hits: list[dict],
+    graph_hits: list[AuxHit],
+    time_hits: list[AuxHit],
+    intent: EvidenceIntent,
+    *,
+    candidate_limit: int,
+) -> tuple[list[dict], dict]:
+    auxiliary = (
+        graph_hits if intent.channel == "graph" else time_hits if intent.channel == "time" else []
+    )
+    if not auxiliary:
+        return content_hits, {
+            "intent": intent.name,
+            "rho": 1.0,
+            "selected_channels": ["content"],
+            "fallback_reason": "no_matching_auxiliary",
+        }
+    max_content = max((h.get("score", 0.0) for h in content_hits), default=0.0)
+    max_aux = max(h.raw_score for h in auxiliary)
+    rows = {
+        h["turn_id"]: dict(h, channels=list(h.get("channels", ["content"]))) for h in content_hits
+    }
+    for row in rows.values():
+        row["score"] = intent.rho * row.get("score", 0.0) / max_content if max_content else 0.0
+    for hit in auxiliary:
+        row = rows.setdefault(
+            hit.turn_id,
+            {"turn_id": hit.turn_id, "query_branches": [0], "score": 0.0, "channels": []},
+        )
+        row["score"] += (1 - intent.rho) * hit.raw_score / max_aux
+        if hit.channel not in row["channels"]:
+            row["channels"].append(hit.channel)
+    ordered = sorted(rows.values(), key=lambda row: (-row["score"], row["turn_id"]))[
+        : max(1, min(candidate_limit, 50))
+    ]
+    return ordered, {
+        "intent": intent.name,
+        "rho": intent.rho,
+        "selected_channels": ["content", intent.channel],
+        "fallback_reason": None,
+    }
diff --git a/openviking/retrieve/evidence_graph.py b/openviking/retrieve/evidence_graph.py
new file mode 100644
index 0000000000000000000000000000000000000000..49876d44215659a70bafda6255e9293ecff102f4
--- /dev/null
+++ b/openviking/retrieve/evidence_graph.py
@@ -0,0 +1,280 @@
+# Copyright (c) 2026 Beijing Volcano Engine Technology Co., Ltd.
+# SPDX-License-Identifier: AGPL-3.0
+"""Deterministic, source-backed entity links for archived evidence windows."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+_CODE = re.compile(
+    r"(?<![\w.])(?:[\w./-]+\.(?:py|ts|tsx|js|jsx|md|json|yaml|yml|sh|toml|rs|go)"
+    r"|[A-Za-z_][\w-]*(?:/[A-Za-z_][\w-]*)+|https?://[^\s\"'<>]+)"
+    r"(?!\w|\.\w)",
+    re.I,
+)
+_TITLE = re.compile(
+    r"(?<!\w)(?:Mr|Ms|Mrs|Dr|Prof)\.?\s+[A-Z][a-z]+\b"
+    r"|[\u4e00-\u9fa5]{1,3}(?:总|经理|老师|医生|教授)"
+)
+_CATEGORIES = {
+    "PERSON": "person",
+    "ORG": "organization",
+    "GPE": "place",
+    "LOC": "place",
+    "NORP": "group",
+    "WORK_OF_ART": "work",
+}
+_NOISE = {"inc", "ltd", "what", "where", "who", "which", "how", "when", "the", "a", "an"}
+MAX_SIGNALS_PER_TURN = 64
+MAX_ENTITIES_PER_WINDOW = 128
+MAX_GRAPH_EDGES = 100000
+
+
+@dataclass(frozen=True)
+class GraphEntitySignal:
+    key: str
+    category: str
+    canonical: str
+    family: str
+    snippet: str
+
+
+def canonical_name(value: str) -> str:
+    return re.sub(r"\s+", " ", value.strip().lower()).strip(".,;:!?\"'` ")
+
+
+def extract_graph_entity_signals(text: str) -> list[GraphEntitySignal]:
+    """Use independent code regex and NER; co-occurrence is never an identity vote."""
+    signals: list[GraphEntitySignal] = []
+    seen: set[tuple[str, str]] = set()
+    code_matches = list(_CODE.finditer(text))
+    for match in code_matches:
+        if len(signals) >= MAX_SIGNALS_PER_TURN:
+            break
+        canonical = canonical_name(match.group())
+        if canonical and len(canonical) <= 120 and ("code:" + canonical, "regex") not in seen:
+            seen.add(("code:" + canonical, "regex"))
+            signals.append(
+                GraphEntitySignal(
+                    "code:" + canonical,
+                    "code",
+                    canonical,
+                    "regex",
+                    text[max(0, match.start() - 40) : match.end() + 40][:120],
+                )
+            )
+    for match in _TITLE.finditer(text):
+        if len(signals) >= MAX_SIGNALS_PER_TURN:
+            break
+        canonical = canonical_name(match.group())
+        key = "person:" + canonical
+        if len(canonical) <= 120 and (key, "title") not in seen:
+            seen.add((key, "title"))
+            signals.append(
+                GraphEntitySignal(
+                    key,
+                    "person",
+                    canonical,
+                    "title",
+                    text[max(0, match.start() - 40) : match.end() + 40][:120],
+                )
+            )
+    # Local import avoids coupling the index serializer to the spaCy loader.
+    from openviking.retrieve.evidence_features import extract_labeled_ents
+
+    for label, values in extract_labeled_ents(text).items():
+        category = _CATEGORIES.get(label)
+        if category is None:
+            continue
+        for value in sorted(values):
+            if len(signals) >= MAX_SIGNALS_PER_TURN:
+                return signals
+            canonical = canonical_name(value)
+            if not canonical or canonical in _NOISE or not 2 <= len(canonical) <= 120:
+                continue
+            key = category + ":" + canonical
+            if (key, "ner") in seen:
+                continue
+            pattern = r"(?<!\w)" + re.escape(value) + r"(?!\w)"
+            match = next(
+                (
+                    m
+                    for m in re.finditer(pattern, text, re.I)
+                    if not any(
+                        code.start() <= m.start() and m.end() <= code.end() for code in code_matches
+                    )
+                ),
+                None,
+            )
+            if match is None:
+                continue
+            seen.add((key, "ner"))
+            snippet = text[max(0, match.start() - 40) : match.end() + 40][:120]
+            signals.append(GraphEntitySignal(key, category, canonical, "ner", snippet))
+    return signals
+
+
+def window_id(archive_uri: str) -> str:
+    return hashlib.sha256(archive_uri.rstrip("/").encode()).hexdigest()[:24]
+
+
+def parse_recorded_time(value: str) -> str | None:
+    try:
+        timestamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
+        # OpenViking's existing archive timestamps may be naive. Interpret
+        # them consistently as UTC rather than losing the entire time view.
+        if timestamp.tzinfo is None:
+            timestamp = timestamp.replace(tzinfo=timezone.utc)
+        return timestamp.astimezone(timezone.utc).isoformat()
+    except (TypeError, ValueError, AttributeError):
+        return None
+
+
+def empty_graph() -> dict:
+    return {
+        "windows": {},
+        "appears_in": {},
+        "adjacent": {},
+        "pending_archive_uris": [],
+        "needs_rebuild": False,
+    }
+
+
+def build_edges(
+    index, window_ids: list[str], *, min_votes: int = 2, min_agreement: float = 1.0
+) -> dict:
+    """Recompute bounded derived edges from source turns; replay cannot add weight."""
+    if min_votes < 1 or not 0 < min_agreement <= 1:
+        raise ValueError("Invalid graph confirmation threshold")
+    windows = index.graph["windows"]
+    changed = set(window_ids)
+    appearances: dict[str, dict] = {
+        key: dict(edge)
+        for key, edge in index.graph["appears_in"].items()
+        if edge["window_id"] in windows and edge["window_id"] not in changed
+    }
+    support: dict[str, set[str]] = {}
+    for edge in appearances.values():
+        support.setdefault(edge["entity_key"], set()).add(edge["window_id"])
+    for wid in sorted(changed):
+        window = windows.get(wid)
+        if window is None:
+            continue
+        window["entity_truncated"] = False
+        window_entity_count = 0
+        for tid in window["turn_ids"]:
+            turn = index._turn_by_id.get(tid)
+            if turn is None:
+                continue
+            for signal in extract_graph_entity_signals(turn["text"]):
+                edge_key = wid + "|" + signal.key
+                if edge_key not in appearances and window_entity_count >= MAX_ENTITIES_PER_WINDOW:
+                    window["entity_truncated"] = True
+                    break
+                if edge_key not in appearances:
+                    window_entity_count += 1
+                edge = appearances.setdefault(
+                    edge_key,
+                    {
+                        "window_id": wid,
+                        "entity_key": signal.key,
+                        "category": signal.category,
+                        "canonical": signal.canonical,
+                        "turn_ids": [],
+                        "source_ids": [],
+                        "signals": [],
+                        "snippet": signal.snippet,
+                        "weight": 0.5,
+                        "support_window_ids": [],
+                        "reason": "",
+                    },
+                )
+                if tid not in edge["turn_ids"]:
+                    edge["turn_ids"].append(tid)
+                source = turn.get("source_id")
+                if source and source not in edge["source_ids"]:
+                    edge["source_ids"].append(source)
+                if signal.family not in edge["signals"]:
+                    edge["signals"].append(signal.family)
+                support.setdefault(signal.key, set()).add(wid)
+            if window["entity_truncated"]:
+                break
+    by_name: dict[str, dict[str, set[str]]] = {}
+    for edge in appearances.values():
+        by_name.setdefault(edge["canonical"], {}).setdefault(edge["category"], set()).add(
+            edge["window_id"]
+        )
+    for edge in appearances.values():
+        supporting = sorted(support[edge["entity_key"]])
+        edge["support_window_ids"] = supporting[:5]
+        edge["support_window_count"] = len(supporting)
+        votes = len(supporting) + max(0, len(edge["signals"]) - 1)
+        categories = by_name[edge["canonical"]]
+        agreement = len(categories[edge["category"]]) / sum(
+            len(windows) for windows in categories.values()
+        )
+        edge["agreement"] = agreement
+        edge["conflict_categories"] = sorted(categories) if len(categories) > 1 else []
+        confirmed = votes >= min_votes and agreement >= min_agreement
+        edge["weight"] = (
+            0.95
+            if confirmed and len(supporting) >= 3
+            else 0.85
+            if confirmed
+            else 0.7
+            if "regex" in edge["signals"]
+            else 0.5
+        )
+        edge["reason"] = (
+            f"signals={','.join(sorted(edge['signals']))}; "
+            f"window_count={len(supporting)}; "
+            f"windows={','.join(supporting[:5])}; turns={','.join(edge['turn_ids'][:5])}"
+        )[:300]
+    if len(appearances) > MAX_GRAPH_EDGES:
+        raise ValueError("Evidence graph edge limit exceeded")
+    adjacent = {}
+    by_session: dict[str, list[tuple[str, dict]]] = {}
+    for wid, window in windows.items():
+        by_session.setdefault(window["session_uri"], []).append((wid, window))
+    for items in by_session.values():
+
+        def order(row):
+            name = row[1]["archive_uri"].rsplit("/", 1)[-1]
+            match = re.fullmatch(r"archive_(\d+)", name)
+            return (int(match[1]) if match else -1, row[1]["archive_uri"])
+
+        items.sort(key=order)
+        for (left, _), (right, _) in zip(items, items[1:], strict=False):
+            adjacent[left + "|" + right] = {
+                "from_window_id": left,
+                "to_window_id": right,
+                "weight": 0.5,
+                "scope": "same_session",
+            }
+    timed = []
+    for wid, window in windows.items():
+        start = parse_recorded_time(window["when_start"])
+        end = parse_recorded_time(window["when_end"])
+        if start and end:
+            timed.append((datetime.fromisoformat(start), datetime.fromisoformat(end), wid, window))
+    timed.sort()
+    for (left_start, left_end, left, left_window), (right_start, _, right, right_window) in zip(
+        timed, timed[1:], strict=False
+    ):
+        if (
+            left_window["session_uri"] != right_window["session_uri"]
+            and left_window["episode"] != right_window["episode"]
+            and left_start < right_start
+            and left_end <= right_start
+            and (right_start - left_end).total_seconds() <= 86400
+        ):
+            adjacent[left + "|" + right] = {
+                "from_window_id": left,
+                "to_window_id": right,
+                "weight": 0.3,
+                "scope": "cross_episode",
+            }
+    return {"appears_in": appearances, "adjacent": adjacent}
