+# Copyright (c) 2026 Beijing Volcano Engine Technology Co., Ltd.
+# SPDX-License-Identifier: AGPL-3.0
+"""Source-backed personal assertions that do not depend on named entities."""
+
+from __future__ import annotations
+
+import re
+from datetime import datetime
+
+from openviking.session.memory.fact_records import _parse, make_fact_records
+
+_PERSONAL = re.compile(
+    r"\b(?:I|I've|I'm|I'd|I'll|my|mine|we|we've|our)\b|(?:我|我们|我的|我们的|咱们)", re.I
+)
+_NUMBER_WORDS = {
+    "one": 1,
+    "two": 2,
+    "three": 3,
+    "four": 4,
+    "five": 5,
+    "six": 6,
+    "seven": 7,
+    "eight": 8,
+    "nine": 9,
+    "ten": 10,
+    "eleven": 11,
+    "twelve": 12,
+    "thirteen": 13,
+    "fourteen": 14,
+    "fifteen": 15,
+    "sixteen": 16,
+    "seventeen": 17,
+    "eighteen": 18,
+    "nineteen": 19,
+    "twenty": 20,
+    "thirty": 30,
+}
+_NUMBER = re.compile(
+    r"(?<![A-Za-z0-9_])(\d+(?:\.\d+)?|" + "|".join(_NUMBER_WORDS) + r")(?![A-Za-z0-9_])", re.I
+)
+_AFTER_NUMBER = re.compile(
+    r"^\s*-?\s*(?:more\s+|new\s+|different\s+|additional\s+)?"
+    r"([a-z][\w-]*(?:\s+[a-z][\w-]*){0,3})",
+    re.I,
+)
+_STOP = {
+    "since",
+    "so",
+    "from",
+    "for",
+    "at",
+    "by",
+    "in",
+    "on",
+    "to",
+    "and",
+    "but",
+    "when",
+    "which",
+    "that",
+}
+_TIME = re.compile(
+    r"\b(?:a|one|two|three|four|\d+)\s+(?:days?|weeks?|months?|years?)\s+ago\b"
+    r"|\b(?:today|yesterday|last\s+(?:week|month|year))\b"
+    r"|\b\d{1,2}\s*(?:am|pm)\b"
+    r"|(?:[一二两三四五六七八九十百\d]+)个?(?:天|周|星期|月|年)前"
+    r"|(?:昨天|前天|上周|上个月|去年)",
+    re.I,
+)
+_SUGGESTION = re.compile(
+    r"\b(?:suggest|recommend|alternative|other\s+terms|options?|examples?)\b", re.I
+)
+_LOW_VALUE = re.compile(
+    r"\b(?:I(?:'m| am)?\s+(?:looking for|wondering|hoping for)|I\s+(?:think|guess|wonder|need)\b)",
+    re.I,
+)
+_CONVERSATION_OBJECT = re.compile(
+    r"\b(?:these|those|this|that|your)\s+(?:ideas?|suggestions?|options?|advice|help|responses?|answers?|recommendations?)\b",
+    re.I,
+)
+_LIST_ITEM = re.compile(r"^\s*\d+[.)]\s+(.+?)(?:\s+[-–—:]\s+|$)")
+_QUOTED_TITLE = re.compile(r"[\"“]([^\"”]{2,70})[\"”]")
+
+
+def _quantity(quote: str) -> dict | None:
+    match = _NUMBER.search(quote)
+    if not match:
+        return None
+    token = match.group(1).casefold()
+    value = _NUMBER_WORDS.get(token)
+    if value is None:
+        value = float(token) if "." in token else int(token)
+    tail = re.split(
+        r"\b(?:since|so far|from|for|at|by|in|on|to|and|but|when|which|that|where|who|while|with)\b|[,.!?]",
+        quote[match.end() :],
+        maxsplit=1,
+        flags=re.I,
+    )[0]
+    noun = _AFTER_NUMBER.match(tail)
+    words = noun.group(1).split() if noun else []
+    words = [word for word in words if word.casefold() not in _STOP]
+    if not words:
+        chinese = re.match(r"\s*([\u4e00-\u9fff]{1,10})", tail)
+        if chinese:
+            words = [chinese.group(1)]
+    if not words:
+        before = quote[: match.start()]
+        count = re.search(r"\b((?:[a-z]+\s+){0,3}(?:count|total))\s+(?:to|of)\s*$", before, re.I)
