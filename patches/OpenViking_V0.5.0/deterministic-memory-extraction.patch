+    selected = []
+    for fact in make_fact_records(
+        text, speaker, source_id, recorded_at, _resolve_dates_in_text, role="user"
+    ):
+        quote = fact["source_quotes"][source_id]
+        if not _PERSONAL.search(quote) or fact["assertion_type"] in {
+            "question",
+            "conditional",
+            "uncertain",
+            "report",
+        }:
+            continue
+        time = _TIME.search(quote)
+        quantity = _quantity(quote)
+        if _LOW_VALUE.search(quote) and not (quantity or time):
+            continue
+        if _CONVERSATION_OBJECT.search(quote) and not (quantity or time):
+            continue
