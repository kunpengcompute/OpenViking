index 0000000000000000000000000000000000000000..6232c4b7e15202e861d06cc4833130d1ad1da669
--- /dev/null
+++ b/Dockerfile.ov
@@ -0,0 +1,37 @@
+# Copyright (c) 2026 Huawei Technologies Co., Ltd.
+# SPDX-License-Identifier: AGPL-3.0
+FROM ghcr.io/astral-sh/uv:0.8.22 AS uv
+FROM openeuler/openeuler:24.03-lts-sp3 AS builder
+SHELL ["/bin/bash", "-o", "pipefail", "-c"]
+RUN dnf install -y gcc gcc-c++ make cmake pkgconf openssl-devel libffi-devel \
+      zlib-devel bzip2-devel xz-devel git curl ca-certificates tar gzip xz unzip \
+    && dnf clean all
+COPY --from=uv /uv /usr/local/bin/uv
+ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy \
+    PATH=/opt/venv/bin:/root/.cargo/bin:$PATH \
+    OV_REQUIRE_RAGFS_BUILD=1 OV_SKIP_STUDIO_BUILD=1 \
+    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OPENVIKING=0.4.1 \
+    CARGO_BUILD_JOBS=4 CMAKE_BUILD_PARALLEL_LEVEL=4 \
+    LITELLM_LOCAL_MODEL_COST_MAP=true
+RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
+    | sh -s -- -y --profile minimal --default-toolchain 1.91.1
+WORKDIR /opt/openviking
+COPY . .
+RUN uv python install 3.11 && uv venv --seed --python 3.11 /opt/venv \
+    && uv pip install --python /opt/venv/bin/python -e '.[deepagents]' \
+         'langchain-openai>=1,<2' python-dotenv \
+    && uv pip check --python /opt/venv/bin/python
+RUN python -c "from openviking.pyagfs import get_binding_client; get_binding_client(); from openviking.storage.vectordb import engine; assert engine.ENGINE_VARIANT != 'unavailable'"
+
+FROM openeuler/openeuler:24.03-lts-sp3
+RUN dnf install -y ca-certificates curl libstdc++ libgcc openssl libffi zlib \
+      bzip2-libs xz-libs sqlite-libs \
+    && dnf clean all
+COPY --from=builder /opt/python /opt/python
+COPY --from=builder /opt/venv /opt/venv
+COPY --from=builder /opt/openviking /opt/openviking
+ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/opt/openviking \
+    LITELLM_LOCAL_MODEL_COST_MAP=true HOME=/tmp
+WORKDIR /opt/openviking
+ENTRYPOINT ["openviking-server"]
+CMD ["--config", "/config/ov.conf"]
