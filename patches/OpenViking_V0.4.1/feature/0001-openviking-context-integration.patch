+@dataclass(frozen=True)
+class RecallResult:
+    """One recall attempt; the caller records every status in OVContext."""
+
+    content: str = ""
+    status: RecallStatus = "empty"
+    count: int = 0
+    stats: dict[str, Any] = field(default_factory=dict)
+
